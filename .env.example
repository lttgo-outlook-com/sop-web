# Local deploy secrets for ./scripts/deploy.sh (npm run deploy).
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# MUST NEVER be committed — it holds live credentials.
#
# Values already exported in your shell are fine too; deploy.sh loads `.env`
# when present, so either works.

# Public base URL of the service (used in OAuth discovery documents).
BASE_URL=https://sop.obacker.com

# Only Google accounts at this domain can sign in (leave empty to allow all).
EMAIL_DOMAIN=obacker.com

# Google OAuth client (type: Web application) created in project obacker-ai.
# Required redirect URI: https://sop.obacker.com/oauth/callback
GOOGLE_CLIENT_ID=<your-client-id.apps.googleusercontent.com>
GOOGLE_CLIENT_SECRET=<your-client-secret>

# Random string >= 32 chars that signs the MCP bearer tokens.
# Generate with: openssl rand -hex 32
OAUTH_HMAC_KEY=<openssl-rand-hex-32>
